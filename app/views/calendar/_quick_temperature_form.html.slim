- field_id = "quick_temperature_#{episode.id}"
.bg-white.rounded-lg.border.border-amber-200.p-3
  .text-xs.font-semibold.text-amber-800.mb-2
    i.fas.fa-temperature-high.mr-1
    | 体温を記録

  = form_with model: HealthEpisodeTemperature.new, url: health_episode_temperatures_path(episode),
              method: :post, id: "quick_temperature_form_#{episode.id}",
              data: { turbo_frame: "_top" }, class: "flex flex-wrap items-end gap-2" do |f|
    = hidden_field_tag :return_to, scope == "my" ? "my_calendar" : "calendar", id: nil
    = hidden_field_tag :date, date.to_s, id: nil

    .form-control
      = f.label :measured_at, "測定時刻", for: "#{field_id}_measured_at", class: "label py-1 text-xs"
      = f.datetime_local_field :measured_at, value: quick_temperature_measured_at(date),
                                              id: "#{field_id}_measured_at", class: "input w-full sm:w-44"
    .form-control
      = f.label :value, "体温", for: "#{field_id}_value", class: "label py-1 text-xs"
      = f.number_field :value, step: 0.1, min: 30, max: 45, placeholder: "36.5",
                               id: "#{field_id}_value", class: "input w-24"
    = f.submit "記録", class: "btn btn-sm btn-primary min-h-11"
