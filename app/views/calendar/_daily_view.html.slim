- if my_scope?
  = render "calendar/my_daily_view", date: date, family_plans: @family_plans, family_tasks: @family_tasks,
                                    family_meals: @family_meals, health_episodes_by_user: @health_episodes_by_user,
                                    scope: current_scope
- else
  = render "calendar/family_daily_view", date: date, family_plans: @family_plans, family_tasks: @family_tasks,
                                        family_meals: @family_meals, target_users: @target_users,
                                        health_episodes_by_user: @health_episodes_by_user, scope: current_scope
