.container.mx-auto.px-4.py-8
  .flex.items-center.justify-between.mb-6
    h1.text-2xl.font-bold.text-gray-800 服薬マスタ
    = link_to 'カレンダーへ', calendar_path, class: 'btn btn-ghost btn-sm'

  .bg-white.rounded-lg.shadow-lg.p-6.space-y-6
    = form_with model: @medication, class: 'flex items-end gap-2' do |f|
      .form-control.flex-1
        = f.label :name, '服薬名', class: 'label'
        = f.text_field :name, class: 'input w-full', placeholder: '薬の名前'
      = f.submit '追加', class: 'btn btn-primary'

    - if @medications.any?
      ul.divide-y.divide-gray-100
        - @medications.each do |medication|
          li.py-3
            = form_with model: medication, class: 'flex items-center gap-2' do |f|
              = f.text_field :name, class: 'input input-sm flex-1'
              = f.submit '更新', class: 'btn btn-sm btn-outline'
    - else
      p.text-sm.text-gray-500 まだ服薬が登録されていません
