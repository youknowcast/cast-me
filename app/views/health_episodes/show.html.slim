.container.mx-auto.px-4.py-8.space-y-6
  .flex.items-center.justify-between.gap-2
    = link_to calendar_path(date: @episode.started_on), class: 'btn btn-ghost btn-sm' do
      i.fas.fa-chevron-left.mr-1
      | カレンダー
    .flex.items-center.gap-2
      = link_to edit_health_episode_path(@episode), class: 'btn btn-sm btn-outline' do
        i.fas.fa-edit.mr-1
        | 編集
      - if @episode.recovered?
        = button_to reopen_health_episode_path(@episode), method: :patch, class: 'btn btn-sm btn-warning',
                                                         form: { class: 'inline' } do
          i.fas.fa-rotate-left.mr-1
          | 解除
      - else
        = button_to recover_health_episode_path(@episode), method: :patch, class: 'btn btn-sm btn-success',
                                                          form: { class: 'inline' } do
          i.fas.fa-check.mr-1
          | 直った

  .bg-white.rounded-lg.shadow-lg.p-6
    .flex.flex-wrap.items-start.justify-between.gap-3
      div
        h1.text-2xl.font-bold.text-gray-800 = @episode.title
        .flex.flex-wrap.items-center.gap-2.mt-2
          span.badge.badge-ghost
            i.fas.fa-user.mr-1
            = @episode.user.display_name
          - if @episode.recovered?
            span.badge.badge-success 回復済み
          - else
            span.badge.badge-warning 経過観察中
      p.text-sm.text-gray-500
        = "#{@episode.started_on.strftime('%Y/%-m/%-d')} 〜 #{@episode.ended_on ? @episode.ended_on.strftime('%Y/%-m/%-d') : '継続中'}"

    - if @episode.symptom_note.present?
      .mt-4.p-3.bg-gray-50.rounded-lg
        p.text-sm.text-gray-700.whitespace-pre-wrap = @episode.symptom_note

  .bg-white.rounded-lg.shadow-lg.p-6
    h2.text-lg.font-semibold.text-gray-800.mb-4
      i.fas.fa-thermometer-half.text-red-500.mr-2
      | 体温

    = form_with model: @temperature, url: health_episode_temperatures_path(@episode),
                id: 'new_health_episode_temperature', class: 'flex flex-wrap items-end gap-2 mb-5' do |f|
      .form-control
        = f.label :measured_at, '測定時刻', class: 'label'
        = f.datetime_local_field :measured_at, class: 'input input-sm w-full'
      .form-control
        = f.label :value, '体温', class: 'label'
        = f.select :value, temperature_choices(@temperature.value),
                   { selected: temperature_input_value(@temperature.value) }, class: 'select select-sm w-28'
      = f.submit '体温を記録', class: 'btn btn-sm btn-primary'

    - if @temperatures_by_date.any?
      .space-y-4
        - @temperatures_by_date.each do |date, temperatures|
          div
            .text-xs.font-semibold.text-gray-500.mb-2 = I18n.l(date, format: '%m月%d日(%a)')
            .space-y-2
              - temperatures.each do |temperature|
                .flex.flex-wrap.items-end.gap-2.bg-gray-50.rounded-lg.p-2
                  span.text-lg.font-bold.text-red-600.w-16
                    = temperature_value(temperature.value)
                    span.text-xs.text-gray-500.ml-0.5 ℃
                  = form_with model: temperature, url: health_episode_temperature_path(@episode, temperature),
                              method: :patch, class: 'flex flex-wrap items-end gap-2 flex-1' do |f|
                    .form-control
                      = f.label :measured_at, '測定時刻', class: 'label'
                      = f.datetime_local_field :measured_at, class: 'input input-xs w-full'
                    .form-control
                      = f.label :value, '体温', class: 'label'
                      = f.select :value, temperature_choices(temperature.value),
                                 { selected: temperature_input_value(temperature.value) },
                                 class: 'select select-xs w-24'
                    = f.submit '更新', class: 'btn btn-xs btn-outline'
                  = button_to health_episode_temperature_path(@episode, temperature), method: :delete,
                              class: 'btn btn-xs btn-ghost text-error',
                              form: { data: { turbo_confirm: 'この体温を削除しますか？' } } do
                    i.fas.fa-trash
    - else
      p.text-sm.text-gray-500 まだ体温の記録はありません

  .bg-white.rounded-lg.shadow-lg.p-6
    h2.text-lg.font-semibold.text-gray-800.mb-4
      i.fas.fa-pills.text-blue-500.mr-2
      | 服薬

    = form_with model: @episode, class: 'space-y-3' do |f|
      - if @medications.any?
        .flex.flex-wrap.gap-3
          = f.collection_check_boxes :medication_ids, @medications, :id, :name do |b|
            label.flex.items-center.gap-2.cursor-pointer
              = b.check_box class: 'checkbox checkbox-sm checkbox-primary'
              span.text-sm = b.text
      - else
        p.text-sm.text-gray-500 服薬マスタがまだありません
      = f.submit '服薬を保存', class: 'btn btn-sm btn-primary'

    .border-t.border-gray-100.mt-4.pt-4
      = form_with model: Medication.new, url: medications_path, class: 'flex items-end gap-2' do |f|
        = hidden_field_tag :health_episode_id, @episode.id
        .form-control.flex-1
          = f.label :name, '服薬を追加', class: 'label'
          = f.text_field :name, class: 'input input-sm w-full', placeholder: '薬の名前'
        = f.submit '追加', class: 'btn btn-sm btn-outline'
      = link_to '服薬マスタを管理', medications_path, class: 'link link-hover text-xs text-gray-500 mt-2 inline-block'

  .bg-white.rounded-lg.shadow-lg.p-6
    h2.text-lg.font-semibold.text-gray-800.mb-1
      i.fas.fa-bell.text-amber-500.mr-2
      | 服薬リマインド
    p.text-xs.text-gray-500.mb-4 設定した時刻に、対象者本人の端末へ服薬のリマインドを送ります。

    - if @reminder_times.any?
      .flex.flex-wrap.gap-2.mb-4
        - @reminder_times.each do |reminder_time|
          div.badge.badge-lg.gap-1
            = reminder_time.label
            = button_to health_episode_reminder_time_path(@episode, reminder_time), method: :delete,
                        class: 'btn btn-ghost btn-xs btn-circle',
                        form: { data: { turbo_confirm: 'この通知時刻を削除しますか？' } } do
              i.fas.fa-times
    - else
      p.text-sm.text-gray-500.mb-4 通知時刻はまだ設定されていません

    = form_with url: health_episode_reminder_times_path(@episode), method: :post,
                class: 'flex items-end gap-2' do
      .form-control
        = label_tag :reminder_time, '通知時刻', class: 'label'
        = select_tag :reminder_time, options_for_select(reminder_time_options), class: 'select select-sm'
      = submit_tag '追加', class: 'btn btn-sm btn-outline'
